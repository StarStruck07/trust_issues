{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["crd/**", "config.yaml", "deploy/**", "tests/fixtures/**", "tests/cases/**"],
        "maxDuration": 30
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }]
}
